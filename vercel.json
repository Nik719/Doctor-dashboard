{
    "buildCommand": "npm run build:client",
    "outputDirectory": "dist/spa",
    "functions": {
          "api/index.ts": {
                  "maxDuration": 30,
                  "includeFiles": "server/**,shared/**"
          }
    },
    "routes": [
          { "src": "/api(.*)", "dest": "/api/index.ts" },
          { "handle": "filesystem" },
          { "src": "/(.*)", "dest": "/index.html" }
    ]
}
